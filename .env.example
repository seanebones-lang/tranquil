# =============================================================
# A Tranquil Space — environment variables
# =============================================================

# ---- Clerk (web authentication — required) ----
# https://dashboard.clerk.com → API Keys for your Next.js app
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Public URL (no trailing slash). Must match the URL users open (digest/cron links use this too).
NEXTAUTH_URL=http://localhost:3000

# ---- Database (Postgres on Railway) ----
# Railway gives you DATABASE_URL automatically; for local dev use:
# postgresql://postgres:postgres@localhost:5432/tranquil
DATABASE_URL=

# Schema → database (pick one workflow):
#   npm run db:deploy      # prod / Railway — applies prisma/migrations (see docs/PRISMA_MIGRATIONS.md)
#   npm run db:migrate     # local dev — create & apply migrations
#   npm run db:push        # quick prototype only (no migration history)

# ---- Email (Resend — magic links removed; still used for weekly digest via cron) ----
AUTH_RESEND_KEY=
EMAIL_FROM=onboarding@resend.dev

# ---- AI provider (any API key — see README "Environment variables") ----
# AI_PROVIDER selects the backend: "openai" (default, any OpenAI-compatible API),
# "anthropic" (Claude Messages API), or "xai"/"grok" (Grok). Leave unset and the
# app auto-detects from your key/model when possible.
AI_PROVIDER=
AI_API_KEY=

# Optional per-model overrides + a custom base URL for OpenAI-compatible gateways
# (OpenRouter, NVIDIA NIM, DeepSeek, Groq, Together, Ollama, LM Studio, …).
# Set only what you need; sensible defaults are chosen per provider.
AI_BASE_URL=
AI_CHAT_MODEL=
AI_CHEAP_MODEL=
AI_EMBEDDING_MODEL=
AI_STT_MODEL=

# Provider-native keys also work:
#   OPENAI_API_KEY   — used when AI_PROVIDER=openai and AI_API_KEY unset
#   ANTHROPIC_API_KEY — used when AI_PROVIDER=anthropic and AI_API_KEY unset
#   XAI_API_KEY       — used when AI_PROVIDER=xai, or fully backward-compatible

# ---- xAI legacy (still required for the proprietary Grok Collections RAG + STT) ----
# Chat, research summarization, and note organization now run on ANY provider via
# AI_* above. The two Grok-only surfaces (Islamic RAG via Grok Collections + voice
# transcription) still need an xAI key + collection IDs below.
XAI_API_KEY=

QURAN_COLLECTION_ID=
HADITH_COLLECTION_ID=
TAFSIR_COLLECTION_ID=

# ---- Cloudflare R2 (voice notes; S3 API keys from Cloudflare Dashboard → R2 → Manage R2 API tokens) ----
# R2_ACCOUNT_ID is your Cloudflare account id (digits). You may also use CLOUDFLARE_ACCOUNT_ID with the same value.
# After changing these, restart Next.js (`npm run dev` / Railway redeploy).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tranquil-audio
R2_PUBLIC_URL=

REDIS_URL=

XAI_BASE_URL=

CRON_SECRET=
