# =============================================================
# A Tranquil Space — environment variables
# =============================================================

# ---- Clerk (web authentication — required) ----
# https://dashboard.clerk.com → API Keys for your Next.js app
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Public URL (no trailing slash). Must match the URL users open (digest/cron links use this too).
NEXTAUTH_URL=http://localhost:3000

# ---- Database (Postgres on Railway) ----
# Railway gives you DATABASE_URL automatically; for local dev use:
# postgresql://postgres:postgres@localhost:5432/tranquil
DATABASE_URL=

# After pulling Clerk changes, apply schema once:
#   npx prisma db push
# (or run a migration in CI / Railway.)

# ---- Email (Resend — magic links removed; still used for weekly digest via cron) ----
AUTH_RESEND_KEY=
EMAIL_FROM=onboarding@resend.dev

# ---- xAI (Grok 4.3, STT, Collections) ----
XAI_API_KEY=

QURAN_COLLECTION_ID=
HADITH_COLLECTION_ID=
TAFSIR_COLLECTION_ID=

# ---- Cloudflare R2 ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tranquil-audio
R2_PUBLIC_URL=

REDIS_URL=

XAI_BASE_URL=

CRON_SECRET=
