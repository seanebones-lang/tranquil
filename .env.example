# =============================================================
# A Tranquil Space — environment variables
# =============================================================

# ---- App ----
# Auth.js requires this. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Public app URL (no trailing slash). Local dev below — production is https://bizbot.store (Railway/Vercel).
NEXTAUTH_URL=http://localhost:3000

# Auth.js v5 also accepts AUTH_URL; in production match NEXTAUTH_URL exactly:
# AUTH_URL=https://bizbot.store

# ---- Database (Postgres on Railway) ----
# Railway gives you DATABASE_URL automatically; for local dev use:
# postgresql://postgres:postgres@localhost:5432/tranquil
#
# Serverless note (Vercel): use your host's pooled connection string if offered;
# direct Railway URLs sometimes fail under burst traffic.
DATABASE_URL=

# ---- Email (Resend, for magic links) ----
# https://resend.com → API Keys
AUTH_RESEND_KEY=
# Dev: onboarding@resend.dev is OK for testing. Prod: verify bizbot.store (or your domain) in Resend.
# EMAIL_FROM=hello@bizbot.store
EMAIL_FROM=onboarding@resend.dev

# ---- xAI (Grok 4.3, STT, Collections) ----
# https://console.x.ai
XAI_API_KEY=

# Set after running seeds/ scripts (Phase 0)
QURAN_COLLECTION_ID=
HADITH_COLLECTION_ID=
TAFSIR_COLLECTION_ID=

# ---- Object storage (Phase 2: audio + PDFs) ----
# Cloudflare R2 — S3-compatible
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tranquil-audio
R2_PUBLIC_URL=

# ---- Redis (Phase 2: background workers) ----
REDIS_URL=

# Optional: override default https://api.x.ai/v1 (worker + REST helpers)
XAI_BASE_URL=

# Vercel cron (Phase 5): Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
NEXTAUTH_URL=https://bizbot.store
AUTH_URL=https://bizbot.store
EMAIL_FROM=hello@bizbot.store
