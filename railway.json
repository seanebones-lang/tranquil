{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm ci && npm run build"
  },
  "deploy": {
    "startCommand": "npm start",
    "restartPolicyType": "ON_FAILURE",
    "runtime": "NODE"
  },
  "services": {
    "web": {
      "build": {
        "builder": "NIXPACKS",
        "buildCommand": "npm ci && npm run build"
      },
      "deploy": {
        "startCommand": "npm start",
        "restartPolicyType": "ON_FAILURE",
        "runtime": "NODE"
      }
    },
    "worker": {
      "build": {
        "builder": "NIXPACKS",
        "buildCommand": "npm ci"
      },
      "deploy": {
        "startCommand": "npm run worker",
        "restartPolicyType": "ON_FAILURE",
        "runtime": "NODE"
      }
    }
  }
}
